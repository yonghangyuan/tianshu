{
  "name": "code-assist",
  "description": "代码生成、文件读写、项目结构分析",
  "trigram": "人",
  "version": 1,
  "tools": [
    {
      "name": "write_file",
      "description": "Write text/Markdown content to a file. Overwrites existing files.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute file path"
          },
          "content": {
            "type": "string",
            "description": "Content to write"
          }
        },
        "required": [
          "path",
          "content"
        ]
      },
      "permission": 2
    },
    {
      "name": "write_docx",
      "description": "Generate a .docx Word document from Markdown content. Supports headings, paragraphs, bold, italic, and lists.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Output .docx file path"
          },
          "title": {
            "type": "string",
            "description": "Document title (appears as heading)"
          },
          "content": {
            "type": "string",
            "description": "Body content in Markdown format. # Heading, **bold**, *italic*, - bullet list, 1. numbered list, --- horizontal rule"
          }
        },
        "required": [
          "path",
          "title",
          "content"
        ]
      },
      "permission": 2
    },
    {
      "name": "list_project",
      "description": "列出项目目录结构（忽略 __pycache__、.git 等）。",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "项目根目录路径",
            "default": "."
          }
        },
        "required": []
      },
      "permission": 0
    }
  ],
  "trigger_keywords": [
    "代码",
    "code",
    "写一个",
    "帮我写",
    "修改文件",
    "创建文件",
    "项目结构",
    "python",
    "Python"
  ],
  "handler": "tianshu.renyao.skills.code_assist:CodeAssistSkill"
}